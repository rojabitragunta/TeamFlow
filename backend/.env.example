DB_HOST=localhost
DB_PORT=3306
DB_NAME=teamflow
DB_USER=root
DB_PASSWORD=changeme

# Set to "true" for managed MySQL-compatible hosts that require TLS, such as
# TiDB Cloud. Leave "false" for a local MySQL install with no TLS configured.
# When true, the connection is verified against a real CA bundle (certifi) —
# certificate/hostname verification is never disabled.
DB_USE_SSL=false

JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Set to "production" (or anything other than development/test/testing) to enforce
# that JWT_SECRET has been changed from the insecure default.
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# One-time token required in the registration request (setup_token field) to create
# the first Admin account. Leave unset to disable admin self-registration entirely
# (admins must then be promoted manually in the database).
ADMIN_SETUP_TOKEN=change-this-to-a-random-one-time-token
